<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OrnamentalFish" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/navy2</item>
        <item name="android:navigationBarColor">@color/navy2</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorPrimary">@color/navy</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
    <style name="Theme.OrnamentalFish.Splash" parent="Theme.OrnamentalFish">
        <item name="android:windowBackground">@color/navy2</item>
    </style>
    <style name="NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/nav_idle</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
